# ============================================================
# TaskFlow — variables de entorno (ejemplo)
# Copia este archivo a `.env` en la raíz y ajusta los valores.
# ============================================================

# --- Base de datos (PostgreSQL 16) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow"
# Base de datos usada por los tests de integración
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_test"

# --- API ---
API_PORT=4000
# Origen permitido para CORS (frontend en dev)
CORS_ORIGIN="http://localhost:5173"

# --- Autenticación JWT ---
# Firma del access token (15 minutos)
JWT_ACCESS_SECRET="taskflow-dev-access-secret-change-me-in-production"
JWT_ACCESS_TTL="15m"
# Firma del refresh token (7 días)
JWT_REFRESH_SECRET="taskflow-dev-refresh-secret-change-me-in-production"
JWT_REFRESH_TTL="7d"

# --- Frontend ---
# URL base de la API consumida por el navegador
VITE_API_URL="http://localhost:4000/api"
