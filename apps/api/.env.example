# Copia este fichero a `.env` (apps/api/.env) y ajusta los valores.

# Base de datos local (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow"
# Base de datos de pruebas (la usan los tests de integración)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_test"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="taskflow-dev-access-secret-change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="taskflow-dev-refresh-secret-change-me-in-production"
JWT_REFRESH_TTL="7d"
